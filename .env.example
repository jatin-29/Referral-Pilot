# ---------------------------------------------------------------------------
# ReferralPilot configuration. Copy to `.env` and fill in what you need.
# Every value below is optional; the defaults are safe (dry-run, no network
# enrichment providers, human approval required before anything is queued).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/referralpilot.db
# EXPORTS_DIR=./exports
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# --- Job harvester (Module A) ----------------------------------------------
HARVEST_INTERVAL_HOURS=6
HTTP_TIMEOUT_SECONDS=20
HTTP_USER_AGENT=ReferralPilot/0.1 (personal job-search assistant)
# Exclude postings that ask for more than this many years of experience.
MAX_REQUIRED_YEARS=2
INCLUDE_INTERNSHIPS=false
# Comma-separated; empty = keep every location.
LOCATION_KEYWORDS=India,Bengaluru,Bangalore,Hyderabad,Pune,Gurugram,Gurgaon,Noida,Delhi,Mumbai,Chennai,Remote
# Respect robots.txt for HTML (non-API) sources such as the YC jobs board.
RESPECT_ROBOTS_TXT=true

# --- Resume tailor (Module B) ------------------------------------------------
# auto = pdflatex -> xelatex -> lualatex -> tectonic -> typst -> fpdf (pure Python)
LATEX_ENGINE=auto
LATEX_TIMEOUT_SECONDS=90
MAX_PROJECTS_ON_RESUME=3
# New jobs are always scored; set true to also compile a tailored PDF for every one
# (otherwise use the one-click "Compile tailored resume" button on the board).
AUTO_TAILOR_NEW_JOBS=false

# --- Prospector (Module C) ---------------------------------------------------
# Comma-separated, in priority order: hunter,apollo,brave,google_cse,duckduckgo
# Leave empty to only generate search links + email-pattern guesses.
CONTACT_PROVIDERS=
MAX_CONTACTS_PER_JOB=5
HUNTER_API_KEY=
APOLLO_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Check that discovered domains have MX records (needs `pip install dnspython`).
VERIFY_MX=true

# --- Outreach (Module D) -----------------------------------------------------
# dry_run writes .eml files to exports/outbox instead of sending.
EMAIL_BACKEND=dry_run
SENDER_NAME=Your Name
SENDER_EMAIL=you@example.com

# SMTP (EMAIL_BACKEND=smtp). For Gmail use an App Password, not your login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false

# IMAP is used for reply / bounce / opt-out detection when EMAIL_BACKEND=smtp.
# Username and password fall back to the SMTP values when empty.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Gmail API (EMAIL_BACKEND=gmail_api). Download an OAuth "Desktop app" client
# from Google Cloud Console, save it here, then run: referralpilot gmail-auth
GMAIL_CREDENTIALS_FILE=./secrets/credentials.json
GMAIL_TOKEN_FILE=./secrets/token.json

# Safety rails. The daily limit is clamped to 20 and the minimum delay to 180s.
DAILY_SEND_LIMIT=20
SEND_DELAY_MIN_SECONDS=180
SEND_DELAY_MAX_SECONDS=420
SEND_WINDOW_START=09:00
SEND_WINDOW_END=19:00
SEND_WEEKDAYS_ONLY=false
PER_COMPANY_DAILY_CAP=3
PER_RECIPIENT_COOLDOWN_DAYS=30
REQUIRE_APPROVAL=true
ATTACH_RESUME=true
FOLLOWUP_AFTER_DAYS=4
FOLLOWUP_AUTO_QUEUE=true
REPLY_CHECK_INTERVAL_MINUTES=30

# --- Dashboard (Module E) ----------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8000
SCHEDULER_ENABLED=true
